{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "saccade-board-viewer",
  "version": "0.1.0",
  "identifier": "dev.saccade.board-viewer",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Board viewer",
        "width": 1100,
        "height": 800,
        "minWidth": 520,
        "minHeight": 360
      }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.png"
    ]
  }
}
